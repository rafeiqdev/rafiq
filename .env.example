# Rafiq Istanbul server configuration — copy to .env and fill in.
# No secrets live in client code; everything below is server-side only.

API_PORT=8787
APP_URL=http://localhost:5173

# ---- This deployment's own origin (CLIENT-side, REQUIRED) ------------------
# THE single source of truth for this site's hostname. Scheme and host only —
# https, no trailing slash, no path (e.g. https://example.com). Validated by
# scripts/siteUrl.mjs.
#
# THERE IS NO FALLBACK, ON PURPOSE. If this is missing or malformed the build
# FAILS: `npm run build` stops in scripts/generate-sitemap.mjs, and `vite build`
# / `vite dev` stop in vite.config.ts. It used to fall back to a hardcoded host
# that did not match what this was actually set to, so a missing value silently
# published 576 sitemap URLs and a canonical tag on the wrong domain — which is
# then submitted to Google by hand. A crash is visible; a wrong host is not.
#
# Everything derived from it, so a domain change is this one line and nothing
# else: canonical/og:url/og:image/twitter:image in index.html, the same tags at
# runtime (src/lib/seo.ts), public/sitemap.xml + public/robots.txt (both
# generated by scripts/generate-sitemap.mjs), and the Google Places Referer
# header locally (api/places-search.ts).
VITE_BASE_URL=

# ---- Supabase (CLIENT-side, REQUIRED) --------------------------------------
# Both are VITE_-prefixed, so they ship in the browser bundle. That is correct
# and safe: the anon key is designed to be public and Row-Level Security is what
# actually protects the data. Never put the service-role key here.
#
# Project Settings -> API: "Project URL" and the "anon public" key.
#
# WITHOUT THESE THE APP IS DEAD. src/lib/supabase.ts sets supabaseEnabled=false,
# every API call throws 503, and the site renders as a permanently signed-out
# guest — no sign-in, no requests, no admin panel, and no error explaining why.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Office address (CLIENT-side, optional) --------------------------------
# Shown to visitors when the interactive map cannot load, alongside a plain
# "open in Google Maps" link that needs no API key (src/components/map/
# MapUnavailable.tsx). One line, as you would write it on a letterhead:
#   VITE_OFFICE_ADDRESS=Barbaros Mah. Örnek Cad. No:12, Ataşehir, İstanbul
#
# Leave EMPTY if there is no public office address. Empty is handled properly —
# the fallback then links to İstanbul without naming a street. Nothing invents
# an address: publishing premises that do not exist would damage exactly the
# trust this site trades on.
VITE_OFFICE_ADDRESS=

# ---- Admin WhatsApp (CLIENT-side, REQUIRED for launch) ---------------------
# International format, digits only, no "+" (e.g. 905551112233).
#
# This is the ONLY channel that reaches you when you are not looking at /admin:
# there is no email, SMTP, push or webhook behind any form in this app. Every
# service request opens a pre-filled WhatsApp message to this number.
#
# If it is missing — or left as the 905000000000 placeholder — the hand-off is
# skipped cleanly (no broken wa.me link is ever built) and the floating WhatsApp
# button and footer link disappear. The unread badge on /admin then becomes your
# only notification, so a request can sit unseen until you next log in.
VITE_WHATSAPP_NUMBER=

# Comma-separated list of emails that get the admin role on registration
ADMIN_EMAILS=rafeiq.dev@gmail.com,admin@rafiq.ist

# Primary admin account — auto-created/synced on every startup, so it always
# works (no password-reset flow needed). Change ADMIN_PASSWORD for production.
ADMIN_EMAIL=rafeiq.dev@gmail.com
ADMIN_PASSWORD=admin

# HMAC secret used to verify payment-gateway webhooks (REQUIRED in production)
PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-string

SESSION_TTL_DAYS=30

# Manual payment rails (shown to the customer at checkout)
BANK_IBAN=TR12 0006 4000 0011 2345 6789 01
BANK_HOLDER=Rafiq Istanbul Danışmanlık Ltd. Şti.
CRYPTO_WALLET=TQrY8mFkD2vXjW3pZsN6bHcL9aGtE5uRw1
CRYPTO_NETWORK=TRC-20 (USDT/USDC)

# Real AI assistant.
# The live chat calls the Vercel function api/ai-chat.ts, which uses Google
# Gemini (free tier). Set these in Vercel → Project → Settings → Environment
# Variables (NOT here — this file is for the legacy Express server only):
#   GEMINI_API_KEY   -> get a free key at https://aistudio.google.com/apikey
#   GEMINI_MODEL     -> optional; defaults to gemini-2.5-flash
# Without a key, the chat automatically uses the built-in deterministic fallback.

# Legacy Express server only (not used by the Vercel deployment):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Google OAuth (Google Identity Services). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Free AI-chat preview for free/light users (messages per account)
FREE_CHAT_MESSAGES=3

# Exchange-rate source
RATES_URL=https://open.er-api.com/v6/latest/USD

# ---- Google Maps (services map) --------------------------------------------
# TWO SEPARATE KEYS. Do not reuse one for both — they need opposite restrictions.
#
# 1) Browser key. Ships in the client bundle (unavoidable: the Maps JS SDK runs
#    in the page), so it MUST be locked down in Google Cloud Console:
#      Application restrictions : HTTP referrers → your domain + http://localhost:*
#      API restrictions         : Maps JavaScript API, Places API (New)
VITE_GOOGLE_MAPS_API_KEY=
#    Map ID from Cloud Console → Map Management. Required for Advanced Markers:
#    an unregistered id is rejected and the pins never render. Falls back to
#    Google's DEMO_MAP_ID for local development if left empty.
VITE_GOOGLE_MAPS_MAP_ID=
#
# 2) Server key. Used only by api/places-search.ts and api/place-photo.ts, which
#    run on Vercel. Never referrer-restricted (servers send no referrer), so it
#    is genuinely secret — set it in the Vercel dashboard, NOT in this file:
#      Application restrictions : None (or IP, if you pin egress)
#      API restrictions         : Places API (New) ONLY
GOOGLE_MAPS_SERVER_KEY=

# ---- Daily FX sync (api/cron/rates-sync.ts) --------------------------------
# All of these are SERVER-side, set in the Vercel dashboard. None is VITE_-
# prefixed, so none can reach the browser bundle.
#
# Vercel sends "Authorization: Bearer $CRON_SECRET" on scheduled invocations.
# Without it the endpoint returns 401, so the URL alone is not enough to run it.
CRON_SECRET=
# Service-role key: bypasses RLS to write fx_rates. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
# Rate provider. Swap for a paid/official feed without touching code; if it
# needs a bearer token, set FX_PROVIDER_KEY.
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
FX_PROVIDER_KEY=
CRYPTO_PROVIDER_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum&vs_currencies=usd
# Optional: POSTed a JSON summary whenever a run is partial or failed. The
# fx_sync_runs table is the durable record; this is just the push notification.
FX_ALERT_WEBHOOK_URL=

# ---- Google Analytics 4 (index.html gtag.js) -------------------------------
# CLIENT-side (Vite exposes VITE_-prefixed vars to the browser bundle).
# Get a Measurement ID at https://analytics.google.com -> Admin -> Data Streams
# -> add/select a Web stream -> the ID looks like "G-XXXXXXXXXX".
# Left empty, the gtag.js snippet in index.html does not load (no tracking in
# local dev unless you set this yourself).
VITE_GA_MEASUREMENT_ID=
