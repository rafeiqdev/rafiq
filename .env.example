# Rafiq Istanbul server configuration — copy to .env and fill in.
# No secrets live in client code; everything below is server-side only.

API_PORT=8787
APP_URL=http://localhost:5173

# Comma-separated list of emails that get the admin role on registration
ADMIN_EMAILS=goldengt.tr@gmail.com,admin@rafiq.ist

# Primary admin account — auto-created/synced on every startup, so it always
# works (no password-reset flow needed). Change ADMIN_PASSWORD for production.
ADMIN_EMAIL=goldengt.tr@gmail.com
ADMIN_PASSWORD=admin

# HMAC secret used to verify payment-gateway webhooks (REQUIRED in production)
PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-string

SESSION_TTL_DAYS=30

# Manual payment rails (shown to the customer at checkout)
BANK_IBAN=TR12 0006 4000 0011 2345 6789 01
BANK_HOLDER=Rafiq Istanbul Danışmanlık Ltd. Şti.
CRYPTO_WALLET=TQrY8mFkD2vXjW3pZsN6bHcL9aGtE5uRw1
CRYPTO_NETWORK=TRC-20 (USDT/USDC)

# Real AI assistant — without a key the server uses a deterministic dev fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Google OAuth (Google Identity Services). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Free AI-chat preview for free/light users (messages per account)
FREE_CHAT_MESSAGES=3

# Exchange-rate source
RATES_URL=https://open.er-api.com/v6/latest/USD
