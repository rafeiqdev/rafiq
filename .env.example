# Rafiq Istanbul server configuration — copy to .env and fill in.
# No secrets live in client code; everything below is server-side only.

API_PORT=8787
APP_URL=http://localhost:5173

# Comma-separated list of emails that get the admin role on registration
ADMIN_EMAILS=goldengt.tr@gmail.com,admin@rafiq.ist

# Primary admin account — auto-created/synced on every startup, so it always
# works (no password-reset flow needed). Change ADMIN_PASSWORD for production.
ADMIN_EMAIL=goldengt.tr@gmail.com
ADMIN_PASSWORD=admin

# HMAC secret used to verify payment-gateway webhooks (REQUIRED in production)
PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-string

SESSION_TTL_DAYS=30

# Manual payment rails (shown to the customer at checkout)
BANK_IBAN=TR12 0006 4000 0011 2345 6789 01
BANK_HOLDER=Rafiq Istanbul Danışmanlık Ltd. Şti.
CRYPTO_WALLET=TQrY8mFkD2vXjW3pZsN6bHcL9aGtE5uRw1
CRYPTO_NETWORK=TRC-20 (USDT/USDC)

# Real AI assistant.
# The live chat calls the Vercel function api/ai-chat.ts, which uses Google
# Gemini (free tier). Set these in Vercel → Project → Settings → Environment
# Variables (NOT here — this file is for the legacy Express server only):
#   GEMINI_API_KEY   -> get a free key at https://aistudio.google.com/apikey
#   GEMINI_MODEL     -> optional; defaults to gemini-2.5-flash
# Without a key, the chat automatically uses the built-in deterministic fallback.

# Legacy Express server only (not used by the Vercel deployment):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Google OAuth (Google Identity Services). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Free AI-chat preview for free/light users (messages per account)
FREE_CHAT_MESSAGES=3

# Exchange-rate source
RATES_URL=https://open.er-api.com/v6/latest/USD

# ---- Google Maps (services map) --------------------------------------------
# TWO SEPARATE KEYS. Do not reuse one for both — they need opposite restrictions.
#
# 1) Browser key. Ships in the client bundle (unavoidable: the Maps JS SDK runs
#    in the page), so it MUST be locked down in Google Cloud Console:
#      Application restrictions : HTTP referrers → your domain + http://localhost:*
#      API restrictions         : Maps JavaScript API, Places API (New)
VITE_GOOGLE_MAPS_API_KEY=
#    Map ID from Cloud Console → Map Management. Required for Advanced Markers:
#    an unregistered id is rejected and the pins never render. Falls back to
#    Google's DEMO_MAP_ID for local development if left empty.
VITE_GOOGLE_MAPS_MAP_ID=
#
# 2) Server key. Used only by api/places-search.ts and api/place-photo.ts, which
#    run on Vercel. Never referrer-restricted (servers send no referrer), so it
#    is genuinely secret — set it in the Vercel dashboard, NOT in this file:
#      Application restrictions : None (or IP, if you pin egress)
#      API restrictions         : Places API (New) ONLY
GOOGLE_MAPS_SERVER_KEY=

# ---- Daily FX sync (api/cron/rates-sync.ts) --------------------------------
# All of these are SERVER-side, set in the Vercel dashboard. None is VITE_-
# prefixed, so none can reach the browser bundle.
#
# Vercel sends "Authorization: Bearer $CRON_SECRET" on scheduled invocations.
# Without it the endpoint returns 401, so the URL alone is not enough to run it.
CRON_SECRET=
# Service-role key: bypasses RLS to write fx_rates. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
# Rate provider. Swap for a paid/official feed without touching code; if it
# needs a bearer token, set FX_PROVIDER_KEY.
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
FX_PROVIDER_KEY=
CRYPTO_PROVIDER_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum&vs_currencies=usd
# Optional: POSTed a JSON summary whenever a run is partial or failed. The
# fx_sync_runs table is the durable record; this is just the push notification.
FX_ALERT_WEBHOOK_URL=
