{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    // vite.config.ts imports scripts/siteUrl.mjs — the single hostname
    // validator, deliberately plain JS so the .mjs build scripts can share it.
    // Its JSDoc carries the types; checkJs stays off so the script itself is
    // not held to this project's strict TS settings.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["vite.config.ts"]
}
