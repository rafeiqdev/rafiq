{
  "name": "rafiq-istanbul",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.mjs",
    "dev:all": "concurrently -k -n web,api \"npm:dev\" \"npm:dev:server\"",
    "build": "node scripts/generate-sitemap.mjs && tsc -b && vite build",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "npm run test:all",
    "test:all": "npm run test:unit && npm run test:legacy-server",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:legacy-server": "node --test server/test.mjs",
    "check:i18n": "node scripts/check-i18n-parity.mjs"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@supabase/supabase-js": "^2.108.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "i18next": "^23.16.8",
    "lucide-react": "^1.17.0",
    "multer": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/google.maps": "^3.65.2",
    "@types/multer": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
