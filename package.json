    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.14",
